int mr=((problem==true)&&(D==0))? 43 : ((problem==true)&&(D==1)) ? 63 : (((problem==true)&&(D==2))? 83 :23);
for(int h = (selectedPdP == 1) ? 3 : (selectedPdP == 2 ? 8 : 14);h < idrow; h++) {
    if((int)output_model3.getCellNumericValue("Feuil1", h, 14) == box.ID) {
        output_model3.setCellValue(time(), "Feuil1", h, mr); // Column O
        break;
    }
}]]></Code>
