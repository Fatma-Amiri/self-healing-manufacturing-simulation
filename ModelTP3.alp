									<Code><![CDATA[BOXX box = (BOXX) agent;
Main main = (Main) box.getOwner();
int m33=((problem==true)&&(D==0))? 41 : ((problem==true)&&(D==1)) ? 61 : (((problem==true)&&(D==2))? 81 :21);
for(int g = (selectedPdP == 1) ? 3 : (selectedPdP == 2 ? 8 : 14);g < idrow; g++) {
    if((int)output_model3.getCellNumericValue("Feuil1", g, 14) == box.ID) {
        output_model3.setCellValue(time(), "Feuil1", g, m33); // Column O
        break;
    }
}]]></Code>
								</Value>
							</Parameter>
