					<Action><![CDATA[// Logic for Hold 1
if (convey1.size() >= capM1) {
    hold1.block();
} else {
    hold1.unblock();
}

// Logic for Hold 2 - Fixed "hold2" name here
if (convey2.size() >= capM2) {
    hold2.block();
} else {
    hold2.unblock(); // You previously had hold1.unblock() here
}

// Logic for Hold 3 - Fixed "hold3" name here
if (convey5.size() >= capM3) {
    hold3.block();
} else {
    hold3.unblock(); // You previously had hold1.unblock() here
}
if (convey8.size() >= capR) {
    hold4.block();
} else {
    hold4.unblock(); // You previously had hold1.unblock() here
}]]></Action>
				</Event>
				<Event>
					<Id>1774666513168</Id>
					<Name><![CDATA[checkProductionFinished]]></Name>
					<X>280</X><Y>-80</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="condition" Mode="occuresOnce">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_SECOND]]></Unit>
						</Rate>
						<Id>1774666513165</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1774684800000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[isProductionRunning && (nbre_PC + nbre_PNC) == plan.length() && plan.length() > 0]]></Condition>
					</Properties>
					<Action><![CDATA[// 1. Calculate final times
end_prod = time();
duree_cycle_prod = end_prod - start_prod;
 double Tis=0 ;
 int ui=((problem==true)&&(D==0))? 45 : ((problem==true)&&(D==1)) ? 65 : (((problem==true)&&(D==2))? 85 :25);int pr=0 ;

 utilizationM1 = (duree_cycle_prod > 0) ? (busy1 / duree_cycle_prod) * 100 : 0;
 utilizationM2 = (duree_cycle_prod > 0) ? (busy2 / duree_cycle_prod) * 100 : 0;
 utilizationM3 = (duree_cycle_prod > 0) ? (busy3 / duree_cycle_prod) * 100 : 0;
int summaryRow = (selectedPdP == 1) ? 7 : (selectedPdP == 2 ? 13 : 21);

output_model3.setCellValue(utilizationM1, "Feuil1", summaryRow, 9);   
output_model3.setCellValue(utilizationM2, "Feuil1", summaryRow, 10);   
output_model3.setCellValue(utilizationM3, "Feuil1", summaryRow, 11);   
output_model3.setCellValue(duree_cycle_prod, "Feuil1", summaryRow, 12); 
output_model3.setCellValue(nbre_PNC, "Feuil1", summaryRow, ui+9); // Col F
output_model3.setCellValue((nbre_PNC*100)/(nbre_PNC+nbre_PC), "Feuil1", summaryRow, ui+8);

int v_row = (selectedPdP == 1) ? 3 : (selectedPdP == 2 ? 8 : 14);
int v_row1 = (selectedPdP == 1) ? 2 : (selectedPdP == 2 ? 7 : 13);
List<Tuple> boxxLogs = selectFrom(agents_log)
    .where(agents_log.type.eq("BOXX")).list();

int count = 0; 
for (Tuple row : boxxLogs) {
    
    if (count >= plan.length()) break; 
    
    Date birth = row.get(agents_log.birthdate);
    Date death = row.get(agents_log.deathdate);

    double d_debut = dateToTime(birth);
    double d_fin   = (death != null) ? dateToTime(death) : 0;

    output_model3.setCellValue(d_debut, "Feuil1", v_row, 15);
    output_model3.setCellValue(d_fin,   "Feuil1", v_row, 16);
    output_model3.setCellValue(d_fin,   "Feuil1", v_row, ui+2);
    double colAA      = output_model3.getCellNumericValue( "Feuil1",v_row, ui+2); // col AA (output)
    double echeance   = input_model3.getCellNumericValue( "Feuil1",v_row1, 22); // col V (input)
        
        double Ti =max(0, colAA - (d_debut + echeance)); 
       Tis=Tis + Ti;
        int    Ui = Ti > 0 ? 1 : 0;                 // KPI1
        if (Ui==1){pr++ ;}
        output_model3.setCellValue(Ti, "Feuil1", v_row, ui+1); // col Z = KPI2(Ti)
        output_model3.setCellValue(Ui, "Feuil1", v_row, ui); // col Y = KPI1(Ui
    v_row++;
     v_row1++;
    count++; 
}
 output_model3.setCellValue(pr, "Feuil1", summaryRow, ui+5);
 output_model3.setCellValue(Tis, "Feuil1", summaryRow, ui+6);
  output_model3.setCellValue(end_prod, "Feuil1", summaryRow, ui+7);
output_model3.writeFile();
traceln("--- PRODUCTION SUMMARY ---");
traceln("PdP: " + selectedPdP);
traceln("Duration: " + duree_cycle_prod);
traceln("M1 Util: " + utilizationM1 + "%");
traceln("M2 Util: " + utilizationM2 + "%");
traceln("M3 Util: " + utilizationM3 + "%");
traceln("Produits conformes: " + nbre_PC );
traceln("Produits non conformes: " + nbre_PNC );
]]></Action>
				</Event>
			</Events>
			<DynamicEvents>
				<DynamicEventClass>
					<Id>1774650598569</Id>
					<Name><![CDATA[injectNext]]></Name>
					<X>280</X><Y>-100</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[isRed]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Action><![CDATA[lastColorWasRed = isRed;
source.inject();]]></Action>
				</DynamicEventClass>
			</DynamicEvents>
			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1774649034726</Id>
					<Name><![CDATA[startProduction]]></Name>
					<X>640</X><Y>-230</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// 1. Reset
plan = ""; 
start_prod = time();

int lastPdPFound = 0; // This will hold the "1" even when cells are empty

// 2. Read Excel rows
for (int row = 2; row <= 20; row++) {
    double cellValue = input_model3.getCellNumericValue("Feuil1", row, 1);
    a=row ;
    // ONLY update if the cell actually has a number. 
    // If it's empty (0), lastPdPFound stays what it was in the previous row.
    if (cellValue > 0) {
        lastPdPFound = (int)cellValue;
    }
    
    // Now this will be TRUE for all 5 rows of PdP 1
    if (lastPdPFound == selectedPdP) {
        double typeVal = input_model3.getCellNumericValue("Feuil1", row, 4);
        
        if (typeVal == 1) plan += "R";
        else if (typeVal == 2) plan += "B";
        
        // Update variables (Note: the loop will keep the values from the LAST row of the PdP)
          T_M1 = (int)input_model3.getCellNumericValue("Feuil1", row, 10);
        T_M2 = (int)input_model3.getCellNumericValue("Feuil1", row, 11);
        T_M3 = (int)input_model3.getCellNumericValue("Feuil1", row, 12);
        capM1 = (int)input_model3.getCellNumericValue("Feuil1", row, 13);
        capM2 = (int)input_model3.getCellNumericValue("Feuil1", row, 14);
        capM3 = (int)input_model3.getCellNumericValue("Feuil1", row, 15);
    }
}
        

int planLength = plan.length();

for(int i = 0; i < planLength; i++) {
    char type = plan.charAt(i);
    boolean colorForThisBox;

    if (type == 'R' || type == 'r') {
        colorForThisBox = true;
    } else {
        colorForThisBox = false;
    }

    // This creates the dynamic event task.
    // (i * 0.1) means: Box 1 at 0s, Box 2 at 0.1s, Box 3 at 0.2s...
    create_injectNext(i * 0.1, colorForThisBox);
}]]></Body>
				</Function>
